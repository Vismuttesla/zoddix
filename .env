# =============================================================================
# TAA — Konfiguratsiya va maxfiy ma'lumotlar fayli
# =============================================================================
# Bu fayl repository ichida saqlanadi, lekin haqiqiy parollar bilan EMAS —
# faqat "QIYMAT_KIRITING" placeholderlari bilan. Repository'ni klon qilgandan
# keyin shu faylni o'zingizning qiymatlaringiz bilan to'ldirasiz.
#
# FOYDALANISH:
#   1) Repository'ni klon qiling:
#         git clone <repo_url> && cd <repo>
#         git checkout script
#   2) ".env" faylni shu hujjatdagi izohlarga qarab to'ldiring
#      (har bir QIYMAT_KIRITING o'rniga o'z qiymatingizni yozing).
#   3) Linux'da faylga ruxsatlarni cheklang:
#         chmod 600 .env
#   4) Sizning haqiqiy parollaringiz git'ga TUSHMASLIGI uchun, fayl
#      o'zgarishlarini git'dan yashiring:
#         git update-index --skip-worktree .env
#   5) Konteynerlarni ko'taring:
#         docker compose up -d
#
# OGOHLANTIRISHLAR:
#   - Bu repository git'ga commit qilinadi — HECH QACHON shu faylga haqiqiy
#     parol yozib commit qilmang. Avval (4)-qadamni bajaring.
#   - Agar repo public bo'lsa — bu yondashuv noxavfsiz. Faqat private repo va
#     ishonchli jamoa uchun.
#   - Agar parol kompromitatsiya qilinsa, darhol o'zgartiring.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) SMTP / Email — taa_email.sh skripti uchun
# -----------------------------------------------------------------------------
# Bu sozlamalar TAA orqali alert email yuborish uchun ishlatiladi.
# Misol uchun: port-security violation bo'lganda admin'ga email keladi.
#
# SMTP_HOST — Email server domeni (TLS ulanish bo'lishi tavsiya etiladi).
#   Gmail:        smtp.gmail.com
#   Yandex:       smtp.yandex.ru
#   Mail.ru:      smtp.mail.ru
#   Office 365:   smtp.office365.com
SMTP_HOST=QIYMAT_KIRITING

# SMTP_PORT — SMTP port.
#   587  -> STARTTLS (Gmail, Yandex, ko'pchilik tavsiya etadigan port)
#   465  -> implicit TLS (eski tipdagi serverlar)
#   25   -> oddiy ulanish, faqat ichki tarmoqda — TAVSIYA ETILMAYDI
SMTP_PORT=587

# SMTP_USER — SMTP autentifikatsiya foydalanuvchi nomi (ko'pincha email manzili).
# Misol: taa.noc@gmail.com
SMTP_USER=QIYMAT_KIRITING

# SMTP_PASS — SMTP paroli.
#   Gmail uchun oddiy parol EMAS — "App Password" kerak:
#     https://myaccount.google.com/apppasswords
#     (Avval 2FA yoqilgan bo'lishi shart.)
#   Yandex uchun ham alohida "ilovalar paroli" yaratish kerak.
SMTP_PASS=QIYMAT_KIRITING

# FROM_ADDR — Xabarlar ichida ko'rinadigan "From:" qatori.
# Format: "Ko'rinadigan nom <email@manzil>" YOKI shunchaki "email@manzil"
# Misol: TAA Alerts <taa.noc@gmail.com>
FROM_ADDR=TAA Alerts <QIYMAT_KIRITING>

# (ixtiyoriy) Default qabul qiluvchi — TAA UI'da User Media orqali ham beriladi,
# bu yer faqat skriptni qo'lda test qilish uchun.
ALERT_TO=admin@taa.local


# -----------------------------------------------------------------------------
# 2) Telegram bot — taa_telegram.sh skripti uchun (ixtiyoriy)
# -----------------------------------------------------------------------------
# Agar Telegram alert kerak bo'lmasa, bu blokni o'zgartirmasdan qoldiring.
#
# TG_TOKEN — Telegram bot'ning tokeni.
#   Olish yo'li:
#     1) Telegram'da @BotFather'ga "/newbot" yuboring
#     2) Bot uchun nom va @username bering
#     3) BotFather sizga token beradi: "123456:ABCdef..."
# Misol: 7654321098:AAEXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TG_TOKEN=QIYMAT_KIRITING

# TG_CHAT_ID — Qabul qiluvchi chat ID si.
#   Shaxsiy chat:  ijobiy raqam (masalan: 123456789)
#   Guruh chat:    salbiy raqam, "-100" bilan boshlanadi (masalan: -1001234567890)
#   ID ni qanday topish:
#     1) Botingizga "salom" yuboring
#     2) Brauzerda oching: https://api.telegram.org/botTOKEN/getUpdates
#     3) JSON ichidan "chat":{"id": ... } ni o'qing
TG_CHAT_ID=QIYMAT_KIRITING


# -----------------------------------------------------------------------------
# 3) Tarmoq qurilmalariga ulanish (SSH/netmiko)
# -----------------------------------------------------------------------------
# Bu sozlamalar 3 ta skript tomonidan ishlatiladi:
#   - auto_remediation.py  (port-security violation bo'lganda portni shutdown qilish)
#   - ip_inventory.py      (DHCP snooping binding'larni yig'ish)
#   - provision_ports.py   (yangi portlarni avtomatik sozlash)
#
# QURILMADA OLDIN BU TAYYORLANISHI KERAK:
#   3560G/1800'da TAA uchun cheklangan account yaratilsin:
#     username taa_auto privilege 15 secret <STRONG_PASSWORD>
#     ip access-list standard TAA_MGMT
#      permit host 10.0.10.10           ! Faqat TAA serveriga ruxsat
#     line vty 0 4
#      access-class TAA_MGMT in
#      transport input ssh
#
# SW_USER — Switchdagi TAA foydalanuvchi nomi (yuqorida yaratilgan).
SW_USER=taa_auto

# SW_PASS — SW_USER ning login paroli.
SW_PASS=QIYMAT_KIRITING

# SW_ENABLE — Enable rejimi paroli (privilege 15 ga o'tish uchun).
# Agar privilege 15 to'g'ridan-to'g'ri berilgan bo'lsa va enable parol talab
# etilmasa, bu maydonni bo'sh qoldiring.
SW_ENABLE=QIYMAT_KIRITING


# -----------------------------------------------------------------------------
# 4) Audit ma'lumotlar bazasi (ichki — odatda o'zgartirilmaydi)
# -----------------------------------------------------------------------------
# auto_remediation.py qaysi DB'ga audit yozadi.
# Default — konteyner ichidagi SQLite (taa-audit volume'ida).
AUDIT_DB=/var/lib/taa/audit.db

# ip_inventory.py uchun PostgreSQL DSN (agar SQLite o'rniga PostgreSQL ishlatsangiz).
# Format: postgres://USER:PASS@HOST:PORT/DBNAME
# Agar SQLite bilan ishlamoqchi bo'lsangiz — bu maydonni o'zgartirmang.
IPAM_DSN=postgres://taa:QIYMAT_KIRITING@postgres:5432/taa_ipam


# -----------------------------------------------------------------------------
# 5) phpIPAM (qo'shimcha modul — agar docker-compose.phpipam.yml ishlatilsa)
# -----------------------------------------------------------------------------
# Agar phpIPAM kerak bo'lmasa — bu blokni o'zgartirmasdan qoldiring.
#
# phpIPAM uchun MariaDB parollari.
PHPIPAM_DB_PASS=QIYMAT_KIRITING
PHPIPAM_DB_ROOT_PASS=QIYMAT_KIRITING

# phpIPAM o'z DB'siga ulanishi uchun (compose'dagi service nomi).
IPAM_DATABASE_HOST=phpipam-mariadb
IPAM_DATABASE_USER=phpipam
IPAM_DATABASE_PASS=QIYMAT_KIRITING


# =============================================================================
# TUGADI. ".env" faylni saqlang va `docker compose up -d` ni ishga tushiring.
# =============================================================================
