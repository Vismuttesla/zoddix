# =============================================================================
# TAA — environment o'zgaruvchilari namunasi
# -----------------------------------------------------------------------------
# Foydalanish:
#   cp scripts/docker/.env.example scripts/docker/.env
#   chmod 600 scripts/docker/.env
#   chown zabbix:zabbix scripts/docker/.env    # (production serverda)
#
# OGOHLANTIRISH: bu fayl namuna. Haqiqiy sekretlar .env ichiga yoziladi va
# git ga commit qilinmaydi. .gitignore ga "scripts/docker/.env" qo'shilsin.
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram bot (taa_telegram.sh uchun)
# -----------------------------------------------------------------------------
# BotFather (https://t.me/BotFather) bergan token. Format: "123456:ABC-DEF..."
TG_TOKEN=000000000:REPLACE_WITH_TELEGRAM_BOT_TOKEN
# Standart chat ID (default media destination). Guruh uchun "-100..." bilan boshlanadi.
TG_CHAT_ID=-1001234567890

# -----------------------------------------------------------------------------
# SMTP / Email (taa_email.sh uchun)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@taa.local
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
FROM_ADDR=TAA Alerts <alerts@taa.local>

# -----------------------------------------------------------------------------
# Tarmoq qurilmalariga ulanish (netmiko — auto_remediation.py, ip_inventory.py)
# -----------------------------------------------------------------------------
# Catalyst 3560G da privilege 15 li va access-class bilan cheklangan account.
SW_USER=taa_auto
SW_PASS=REPLACE_WITH_SWITCH_PASSWORD
SW_ENABLE=REPLACE_WITH_ENABLE_SECRET

# -----------------------------------------------------------------------------
# TAA IPAM (Postgres) — ip_inventory.py uchun DSN
# -----------------------------------------------------------------------------
# Format: postgres://USER:PASS@HOST:PORT/DBNAME
# Asosiy compose'dagi "postgres" konteyneri ichida taa_ipam DB ochib qo'yilgan.
IPAM_DSN=postgres://taa:REPLACE_WITH_PG_PASSWORD@postgres:5432/taa_ipam

# -----------------------------------------------------------------------------
# phpIPAM (docker-compose.phpipam.yml uchun)
# -----------------------------------------------------------------------------
PHPIPAM_DB_PASS=REPLACE_WITH_PHPIPAM_DB_PASSWORD
PHPIPAM_DB_ROOT_PASS=REPLACE_WITH_PHPIPAM_MARIADB_ROOT_PASSWORD

# phpIPAM ichidan MariaDB ga ulanish (default — kompozdagi service nom)
IPAM_DATABASE_HOST=phpipam-mariadb
IPAM_DATABASE_USER=phpipam
IPAM_DATABASE_PASS=REPLACE_WITH_PHPIPAM_DB_PASSWORD
